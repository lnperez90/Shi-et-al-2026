#Index the genome (if not yet indexed)

bowtie2-build <genome>.fasta <output file with no extension>

#Trimming reads

NGmerge -a -e 20 -n 15 -1 <fastq1> -2 <fastq2> -o <filename>_trimmed


#Mapping to genome

bowtie2 -x path/<genomename> -X 2000 -1 <fastq1> -2 <fastq2> -p 38 | samtools view -b -S - | samtools sort --> <filename>.bam

#Indexing the .bam file

samtools index <filename>.bam

#Basic BAM stats

samtools flagstat <yourbam>

##Fragment size distribution and library complexity

#download .bam and bam.bai files from the server to the computer (or use R on linux)

#perform tasks immediately post bowtie2. 
#Requires install ATACseqQC in rStudio (or use R in linux, remember to activate environment r-diffbind)

library(ATACseqQC)

#After loading the package above, go to session – set working directory – choose directory 
#input the bamFile from the ATACseqQC package 

bamfile <- “/folder/pathtoyourfile.bam”
bamfile.labels <- gsub(".bam", "", basename(bamfile))

#Assessing library complexity

estimateLibComplexity(readsDupFreq(bamfile))

#Assessing insert size distribution

fragSize <- fragSizeDist(bamfile, bamfile.labels)

#Save both PDF files in your working folder!!!

#Generate a bigwig version of your bam file (more compact and easier to load later on IGV)

bamCoverage --bam <yourbam> --outFileName <yourbam>.bw --outFileFormat bigwig --normalizeUsing RPGC --binSize 10 --numberOfProcessors 65 --effectiveGenomeSize 28203219823

#Adjust parameter --numberOfProcessors according to availability of threads
#The effectiveGenomeSize used here was the Axolotl. For Polypterus, change to 3673880163. For Protopterus: 39061234303


#Namesort bam for Genrich

samtools sort -@ 30 -n <filename>_trimmed.bam   > <filename>_trimmed_namesorted.bam

#Adjust parameter -@ according to availability of threads

#Peak-calling with Genrich 
#(Genrich will remove duplicates (bypass Picard), analyze multimapped reads and analyze replicas (bypass IDR), remove mitochondrial chromosome, and remove alignments under MAPQ 30. Currently setting area under curve to 0 (-a 0)

Genrich -t <filename1>_trimmed_namesorted.bam,<filename2>_trimmed_namesorted.bam -o <filenamereplicas>namesorted.narrowPeak -j -y -r -v -m 30 -e NC_004418.1 -a 0 -f <filenamereplicas>jyrveNC_004418.1a0.log

#note: use the option -f to create a log file (include Genrich parameters in log file name). If desired, you can later rerun genrich using -P and this log file and modifying parameters, and Genrich will run much faster. Example below (changed the p value from default -p 0.01 to -p 0.001)

Genrich -P -f <filenamereplicas>jyrveNC_004418.1a0.log -o <filenamereplicas>jyrveNC_004418.1a0.narrowPeak -j -y -r -v -e Mit -a 0 -p 0.001


#Differential peaks with Diffbind
#The remaining steps need to be executed on Rstudio (or R in linux)
# using the Diffbind package in R
# metadata is a spreadsheet in .csv (comma separated values) format, arranged as follows (example):
SampleID	Condition	Replicate	bamReads	Peaks	PeakCaller

#Once table is made, save all files of interest on the same folder (bam files, bam.bai files, peak files, csv file)
#Load libraries:

library(DiffBind)
library(tidyverse)

#Click on option “Import dataset (From text (Base)” and select your csv file.
#On “Session” select “Working directory” and select the folder where your files are.

metadata_final <- dba(sampleSheet = "metadata.csv")

# count reads
> metadata_final75 <- dba.count(metarada_final, summits = 75)


> counts <- dba.peakset(metadaata_final75, bRetrieve=TRUE, writeFile="readscores.txt")

#Establish the contrast

metadata_final75 <- dba.contrast(metadata_final75, minMembers=2, categories = DBA_CONDITION)

# Analyze and normalize
# using as input the resulting contrast file, normalize (4 options)
#Using counts on Full libraries (my preferred):
metadata_final75_RLE_full <- dba.normalize(metadata_final75, method=DBA_ALL_METHODS,
                           normalize=DBA_NORM_RLE, 
                           library=DBA_LIBSIZE_FULL)
dba.normalize(metadata_final75_RLE_full, method=DBA_DESEQ2, bRetrieve=TRUE)
dba.normalize(metadata_final75_RLE_full, method=DBA_EDGER, bRetrieve=TRUE)
metadata_final75_RLE_full <- dba.analyze(metadata_final75_RLE_full, method=DBA_ALL_METHODS)
dba.show(metadata_final75_RLE_full, bContrasts=TRUE)


