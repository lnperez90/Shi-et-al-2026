2. Correct bams and find Atacseq footprints with TOBIAS

#First, for each condition, merge and index experimental bam files into a single bam (use -@ to set thread number)

samtools merge <merged.bam> bam1.bam bam2.bam bam3.bam 

samtools index merged.bam

#Adjust parameter -@ according to availability of threads
#Next, BAM alignment correction (series of bw files will be created, including corrected.bw)

Optional: Before moving forward, you may want to generate a .bw file of your merged bams. If so: 
bamCoverage --bam <yourbam> --outFileName <yourbam>.bw --outFileFormat bigwig --normalizeUsing RPGC --binSize 10 --numberOfProcessors 65 --effectiveGenomeSize 28203219823


TOBIAS ATACorrect --bam path/merged.bam --genome path/genome.fa --peaks path/file.narrowPeak --cores 20

#Adjust parameter --cores according to availability of threads
#Then, TOBIAS Footprints (footprints.bw will be created)

TOBIAS FootprintScores --signal merged_corrected.bw --regions path/file.narrowPeak --output merged_footprints.bw --cores 20

TOBIAS BINDetect --motifs path/jasparmotifs --signals path/condition1_footprints.bw path/condition2_footprints.bw --genome path/genome.fasta --peaks consensus.narrowPeak --outdir BINDetect_output --cond_names Cond1 Cond2 --cores 40

